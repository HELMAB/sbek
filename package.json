{
  "name": "sbek",
  "version": "1.0.0",
  "description": "Sbek WordPress theme build tooling (Tailwind CSS v4).",
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./assets/css/src/input.css -o ./assets/css/main.css --minify && npm run --silent build:editor",
    "watch": "npx @tailwindcss/cli -i ./assets/css/src/input.css -o ./assets/css/main.css --watch",
    "build:admin": "npx @tailwindcss/cli -i ./assets/css/src/admin.css -o ./assets/css/admin.css --minify",
    "watch:admin": "npx @tailwindcss/cli -i ./assets/css/src/admin.css -o ./assets/css/admin.css --watch",
    "build:editor": "npx @tailwindcss/cli -i ./assets/css/src/editor.css -o ./assets/css/editor.css --minify"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "tailwindcss": "^4.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
